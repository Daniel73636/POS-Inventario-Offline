# ---------- API (apps/api) ----------
PORT=4000
# Vacío = PostgreSQL embebido (PGlite) en apps/api/data/pglite, sin Docker.
# Con Docker: docker compose up -d postgres
# DATABASE_URL=postgres://pos:pos@localhost:5432/pos
DATABASE_URL=
PGLITE_DIR=./data/pglite
JWT_SECRET=cambia-esto-en-produccion
CORS_ORIGINS=*
SEED_DEMO=true
BUSINESS_TZ=America/Bogota

# ---------- Caja PC (apps/pos-web) y panel (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
