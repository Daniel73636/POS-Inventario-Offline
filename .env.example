# ---------- API (apps/api) ----------
# La API valida estas variables al arrancar y se niega a iniciar si son inválidas.
NODE_ENV=development
PORT=4000
# Vacío = PostgreSQL embebido (PGlite) en apps/api/data/pglite, sin Docker. Obligatorio en producción.
# Con Docker: docker compose up -d postgres
# DATABASE_URL=postgres://pos:pos@localhost:5432/pos
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Producción: mínimo 32 caracteres aleatorios (p. ej. `openssl rand -base64 48`).
JWT_SECRET=cambia-esto-en-produccion
# Producción: lista de orígenes separados por coma (no se acepta *).
CORS_ORIGINS=*
# Tienda demo, código DEMO-2026 y PINs conocidos. Por defecto true fuera de producción y false en producción.
DEMO_MODE=true
SEED_DEMO=true
BUSINESS_TZ=America/Bogota
# Intentos por minuto para login del dueño y registro de cajas (por IP).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# No hay variables de un proveedor DIAN: la API usa el simulador sin validez legal.
# Ver docs/FACTURACION_DIAN.md antes de abrir cuentas o certificados.

# ---------- Caja PC (apps/pos-web) y panel (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Botón "Modo demo" y pistas de PIN en la caja. Por defecto sólo fuera de producción.
NEXT_PUBLIC_DEMO_MODE=true
