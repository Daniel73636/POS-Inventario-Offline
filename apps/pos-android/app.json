{
  "expo": {
    "name": "POS MiniMarket",
    "slug": "pos-minimarket",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.minimarket.pos",
      "permissions": ["android.permission.CAMERA", "android.permission.VIBRATE"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "La cámara se usa para escanear códigos de barras de los productos." }],
      "expo-sqlite"
    ]
  }
}
