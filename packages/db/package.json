{
  "name": "@pos/db",
  "version": "0.1.0",
  "private": true,
  "description": "Base central PostgreSQL (o PGlite embebido): esquema, proyector de eventos, ingesta idempotente y seed",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@pos/contracts": "workspace:*",
    "@pos/domain-pos": "workspace:*",
    "@pos/sync-engine": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
