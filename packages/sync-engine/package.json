{
  "name": "@pos/sync-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de sincronización offline-first: HLC, UUIDv7, proyecciones y cliente push/pull",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pos/contracts": "workspace:*",
    "@pos/domain-pos": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
